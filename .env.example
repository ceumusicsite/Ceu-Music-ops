# ============================================
# ConfiguraÃ§Ã£o do Supabase (OBRIGATÃ“RIO)
# ============================================
# Obtenha essas credenciais em: https://app.supabase.com
# VÃ¡ em Settings > API
VITE_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# ============================================
# ConfiguraÃ§Ã£o do Cloudflare R2 (OPCIONAL)
# ============================================
# Se nÃ£o configurar, o sistema usarÃ¡ Supabase Storage
# Obtenha essas credenciais em: https://dash.cloudflare.com
# VÃ¡ em R2 > Manage R2 API Tokens
VITE_R2_ACCOUNT_ID=seu_account_id_aqui
VITE_R2_ACCESS_KEY_ID=seu_access_key_id_aqui
VITE_R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui
VITE_R2_ENDPOINT=https://seu-account-id.r2.cloudflarestorage.com
VITE_R2_PUBLIC_URL=https://pub-seu-account-id.r2.dev

# Buckets R2 (valores padrÃ£o serÃ£o usados se nÃ£o especificados)
VITE_R2_BUCKET_DOCUMENTOS=ceu-music-documentos
VITE_R2_BUCKET_ANEXOS=ceu-music-anexos
VITE_R2_BUCKET_COMPROVANTES=ceu-music-comprovantes
VITE_R2_BUCKET_AUDIO=ceu-music-audio

# Provider de Storage (r2 ou supabase)
# Se nÃ£o especificado, usarÃ¡ 'r2' por padrÃ£o
VITE_STORAGE_PROVIDER=r2

# ============================================
# ConfiguraÃ§Ã£o do Cloudflare Stream (OPCIONAL)
# ============================================
# Base URL do player do Cloudflare Stream
# Exemplo: https://customer-abc123.cloudflarestream.com
# Obtenha em: Cloudflare Dashboard > Stream > Overview
VITE_STREAM_CUSTOMER_BASE_URL=

# ============================================
# ConfiguraÃ§Ã£o do Vite (OPCIONAL)
# ============================================
# Caminho base da aplicaÃ§Ã£o (padrÃ£o: /)
BASE_PATH=/

# Modo preview (padrÃ£o: false)
IS_PREVIEW=false

# ============================================
