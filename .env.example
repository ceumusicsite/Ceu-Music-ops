# ============================================
# ConfiguraÃ§Ã£o do Supabase
# ============================================
# URL do projeto Supabase (encontrado em Settings > API)
VITE_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pÃºblica (anon key) do Supabase (encontrado em Settings > API)
VITE_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Chave de serviÃ§o do Supabase (apenas para scripts - NÃƒO usar no frontend)
# Encontrado em Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ============================================
# ConfiguraÃ§Ã£o do Cloudflare R2
# ============================================
# Account ID do Cloudflare (encontrado no dashboard do R2)
VITE_R2_ACCOUNT_ID=seu_account_id_aqui

# Access Key ID do token R2
VITE_R2_ACCESS_KEY_ID=seu_access_key_id_aqui

# Secret Access Key do token R2 (mantenha seguro!)
VITE_R2_SECRET_ACCESS_KEY=seu_secret_access_key_aqui

# Endpoint do R2 (geralmente: https://<account_id>.r2.cloudflarestorage.com)
VITE_R2_ENDPOINT=https://seu_account_id.r2.cloudflarestorage.com

# URL pÃºblica do R2 (opcional - para buckets pÃºblicos)
# Formato: https://pub-<account_id>.r2.dev
VITE_R2_PUBLIC_URL=https://pub-seu_account_id.r2.dev

# Nomes dos buckets R2
VITE_R2_BUCKET_DOCUMENTOS=ceu-music-documentos
VITE_R2_BUCKET_ANEXOS=ceu-music-anexos
VITE_R2_BUCKET_COMPROVANTES=ceu-music-comprovantes
VITE_R2_BUCKET_AUDIO=ceu-music-audio

# Provider de storage (r2 ou supabase)
VITE_STORAGE_PROVIDER=r2

# ============================================
# ConfiguraÃ§Ãµes do Vite (Opcionais)
# ============================================
# Caminho base da aplicaÃ§Ã£o (padrÃ£o: /)
BASE_PATH=/

# Modo de preview (true/false)
IS_PREVIEW=false

# IDs do projeto (usado em alguns ambientes especÃ­ficos)
PROJECT_ID=
VERSION_ID=
READDY_AI_DOMAIN=
