# Normalizar quebras de linha automaticamente
* text=auto

# Arquivos de código - usar LF (Unix)
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Arquivos de configuração
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf
vite.config.ts text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

# Binários - não normalizar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
